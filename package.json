{
  "name": "koma2-resume",
  "version": "2.0.4",
  "description": "yuki koma2's resume",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "lint": "textlint docs/README.md",
    "lint:fix": "npm run lint -- fix",
    "lint:generated": "textlint docs/README_generated.md docs/README_summary.md",
    "lint:secrets": "textlint -c .textlintrc.local.json docs/README.md docs/README_generated.md docs/README_summary.md",
    "test": "jest",
    "setup:hooks": "bash scripts/install-hooks.sh",
    "build": "md-to-pdf docs/README.md --config-file config/md-to-pdf.config.json",
    "generate": "ts-node scripts/generate.ts",
    "validate": "ts-node scripts/validate.ts"
  },
  "author": "@yuki-koma2",
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-typescript": "^7.22.5",
    "@jest/globals": "^29.5.0",
    "@textlint/textlint-plugin-markdown": "^13.3.2",
    "@types/jest": "^29.5.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.7",
    "babel-jest": "^29.5.0",
    "jest": "^29.6.1",
    "js-yaml": "^4.3.1",
    "md-to-pdf": "^5.2.5",
    "prh": "^5.4.4",
    "textlint": "^15.6.0",
    "textlint-rule-ja-hiragana-keishikimeishi": "^1.1.0",
    "textlint-rule-ja-no-redundant-expression": "^4.0.1",
    "textlint-rule-preset-ja-spacing": "^2.3.0",
    "textlint-rule-preset-japanese": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
