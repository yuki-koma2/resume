version: 1

# このファイルは public な「禁止語リストの書き方サンプル」です。
# 実際の禁止語は dictionary/prh_secrets.yml（gitignore 済）に書きます。
# 新環境でセットアップするときは:
#   cp dictionary/prh_secrets.yml.example dictionary/prh_secrets.yml
# したあと、prh_secrets.yml に実値（病院名・個人名・社内コードネーム等）を書き込んでください。
#
# 記法は prh: https://github.com/vvakame/prh/tree/master/misc

rules:
  # コードネーム（命名規則ベースの例）
  - expected: "[要匿名化:コードネーム]"
    patterns:
      - /__SAMPLE_INTERNAL_CODENAME__/

  # 顧客名（病院・施設名の例）
  - expected: "[要匿名化:顧客名]"
    patterns:
      - /__SAMPLE_CUSTOMER_NAME__/

  # 個人名（協業者・退職者の例）
  - expected: "[要匿名化:個人名]"
    patterns:
      - /__SAMPLE_PERSON_NAME__/
